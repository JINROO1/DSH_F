{
  "name": "dsh-fedora",
  "version": "0.1.2",
  "private": true,
  "description": "DeepSeek Harness para Fedora KDE Plasma — edición de escritorio comunitaria",
  "license": "MIT",
  "author": "DSH_F contributors",
  "type": "module",
  "main": "dist/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "npm ci && npm --prefix runtime ci",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run test:integration && npm run test:e2e",
    "test:electron": "node scripts/electron-smoke.mjs",
    "desktop": "npm run build && electron .",
    "preview": "npm run build && node scripts/preview.mjs",
    "package:runtime": "node scripts/stage-runtime.mjs",
    "package:fedora": "npm run package:runtime && electron-builder --linux rpm --x64 --publish never",
    "audit:dependencies": "npm audit --omit=dev && npm --prefix runtime audit --omit=dev",
    "sbom": "node scripts/sbom.mjs",
    "licenses": "node scripts/licenses.mjs",
    "upstream:prepare": "node scripts/prepare-upstream.mjs",
    "updates:check": "npm run build && node scripts/check-updates.mjs",
    "measure:performance": "npm run build && node scripts/measure-performance.mjs",
    "qualify:runtime": "node scripts/qualify-runtime.mjs",
    "source:archive": "node scripts/source-archive.mjs"
  },
  "dependencies": {
    "ws": "8.22.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.2.8",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@sparticuz/chromium": "133.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
